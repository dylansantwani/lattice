{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lattice.local/computer-use/v1/event.schema.json",
  "title": "CoreEvent",
  "description": "Canonical run events emitted by the computer-use core. Hosts (Lattice, MCP clients) map these to their own event streams. seq is monotonic per core instance.",
  "type": "object",
  "additionalProperties": false,
  "required": ["seq", "at", "sessionId", "kind", "payload"],
  "properties": {
    "seq": { "type": "integer", "minimum": 1 },
    "at": { "type": "string", "format": "date-time" },
    "sessionId": { "type": "string", "minLength": 1 },
    "kind": {
      "enum": [
        "session_started",
        "session_ended",
        "observation",
        "proposal",
        "lease_granted",
        "lease_revoked",
        "action_started",
        "action_completed",
        "action_failed",
        "user_intervention",
        "paused",
        "resumed",
        "focus_requested",
        "permission_required",
        "stale_detected",
        "source_unavailable",
        "cancelled",
        "error"
      ]
    },
    "payload": { "type": "object" }
  }
}
