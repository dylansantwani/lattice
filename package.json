{
  "name": "lattice",
  "productName": "Lattice",
  "version": "0.1.0",
  "description": "A local-first control room for long-running agentic work.",
  "main": "out/main/index.js",
  "private": true,
  "type": "module",
  "bin": {
    "lattice": "bin/lattice",
    "lat": "bin/lattice"
  },
  "scripts": {
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build",
    "build:headless": "node scripts/build-headless.mjs",
    "build:cli": "node scripts/build-cli.mjs",
    "cli": "node scripts/build-cli.mjs && node out/cli/lattice.cjs",
    "test:e2e:cli": "node scripts/e2e-cli.mjs",
    "start:headless": "node out/headless/index.cjs",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:packages": "pnpm --filter @lattice/computer-use-protocol test",
    "package": "node scripts/make-icon.mjs && electron-vite build && node scripts/build-cli.mjs && electron-builder --mac --config electron-builder.yml",
    "icon": "node scripts/make-icon.mjs",
    "harness": "vite --config vite.harness.config.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.22.0",
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/ws": "^8.5.12",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "better-sqlite3": "^13.0.3",
    "eventsource-parser": "^4.1.0",
    "gpt-tokenizer": "^4.0.0",
    "katex": "^0.18.4",
    "material-symbols": "^0.47.0",
    "node-pty": "^1.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "shiki": "^4.4.3",
    "unified": "^11.0.5",
    "ws": "^8.18.0",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  }
}
